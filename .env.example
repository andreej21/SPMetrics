# ─────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────
# Leave DATABASE_URL empty in local dev to use the embedded PGlite
# database (Postgres-in-WASM, stored in ./.pgdata). No install needed.
#
# In production, point this at a real Postgres instance.
#
# Supabase (use the "Session pooler" or "Direct connection" string, port 5432 —
# NOT the transaction pooler on 6543, which breaks Drizzle's prepared statements):
#   DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# Generic:
#   DATABASE_URL="postgres://user:pass@host:5432/spmetrics?sslmode=require"
DATABASE_URL=""

# Where PGlite persists local data (dev only). Relative to project root.
PGLITE_DATA_DIR=".pgdata"

# ─────────────────────────────────────────────────────────────
# Pixel / app
# ─────────────────────────────────────────────────────────────
# Public origin the pixel and collector are served from.
# Used to build the snippet and set first-party cookies.
NEXT_PUBLIC_COLLECTOR_ORIGIN="http://localhost:3000"

# Cookie domain for the first-party visitor id. Leave blank to use the
# request host. In production set to your collector domain, e.g. ".metrics.yourshop.com"
COOKIE_DOMAIN=""
