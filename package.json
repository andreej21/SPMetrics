{
  "name": "spmetrics",
  "version": "0.1.0",
  "private": true,
  "description": "SPMetrics — Smart Pixel Metrics: first-party analytics & attribution pixel + event pipeline",
  "scripts": {
    "dev": "next dev",
    "build": "npm run pixel:build && next build",
    "start": "next start",
    "pixel:build": "node scripts/build-pixel.mjs",
    "pixel:watch": "node scripts/build-pixel.mjs --watch",
    "icons:build": "node scripts/make-icons.mjs",
    "db:migrate": "tsx src/db/migrate.ts",
    "site:create": "tsx src/db/create-site.ts",
    "spend:add": "tsx src/db/spend-add.ts",
    "spend:meta": "tsx src/db/spend-meta.ts",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "seed": "tsx src/db/seed.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "drizzle-orm": "^0.38.3",
    "next": "^15.1.6",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.7",
    "drizzle-kit": "^0.30.2",
    "esbuild": "^0.24.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
